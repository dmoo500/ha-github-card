{
  "name": "ha-github-card",
  "version": "0.1.0",
  "description": "Home Assistant custom Lovelace card to display GitHub service information",
  "main": "ha-github-card.js",
  "homepage": "https://github.com/dmoo500/ha-github-card",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmoo500/ha-github-card.git"
  },
  "bugs": {
    "url": "https://github.com/dmoo500/ha-github-card/issues"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "serve": "python3 -m http.server 8000",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts --no-warn-ignored",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "node --test",
    "prepare": "yarn build",
    "validate": "yarn type-check && yarn lint && yarn format:check && yarn validate:badges",
    "validate:badges": "node scripts/validate-badges.mjs",
    "release": "yarn validate && yarn build"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "custom-card",
    "lovelace",
    "github",
    "typescript",
    "lit-element"
  ],
  "author": {
    "name": "ha-github-card Contributors"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
